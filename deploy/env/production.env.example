# Production environment reference — copy relevant values into the real
# .env on the production host. Never commit a real .env; this file only
# documents which keys differ from the local-dev defaults in .env.example
# and why. Generate APP_KEY with `php artisan key:generate` on the server,
# once, and keep it out of version control forever after.

APP_NAME="Retail ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.example.com   # replace with the real domain

# MySQL, not SQLite — SQLite is a local-dev/CI convenience only (see
# docs/architecture, and the multi-tenant indexing work in
# docs/architecture/06-api-design.md §6.7). A single-writer SQLite file
# cannot hold up under concurrent POS terminals across branches.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=retail_erp
DB_USERNAME=retail_erp
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb listens on 127.0.0.1:8080 behind Nginx, which terminates TLS and
# proxies /app (websocket) — see deploy/nginx/retail-erp.conf. Public
# clients connect over wss:// on 443, never directly to :8080.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="app.example.com"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notifications@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=warning

FILESYSTEM_DISK=local
# Backups (Modules/Backup) write timestamped archives under storage/app —
# make sure the disk backing storage/app has room for the retention
# policy configured in Settings, and is on a volume that itself gets
# snapshotted/off-boxed, not just backed up "into itself".
