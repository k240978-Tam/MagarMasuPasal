includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 3
    paths:
        - app
        - Modules
    excludePaths:
        - Modules/*/tests/*
        - Modules/*/database/*
    tmpDir: storage/phpstan
    # checkModelProperties is a different feature entirely (catches typos
    # in array keys like User::create(['emaiil' => ...])) — not what
    # suppresses "undefined property" on direct $model->column access.
    # That suppression comes from Larastan statically parsing migration
    # *files* (not a live DB) to learn each model's columns, and it only
    # scans database/migrations by default. Every module keeps its actual
    # schema-defining migrations under Modules/*/database/migrations
    # (nwidart/laravel-modules convention) — Larastan never saw any of
    # them, which is why every magic property access on every model was
    # flagged (306 findings, one root cause, not 306 bugs).
    checkModelProperties: true
    databaseMigrationsPath:
        - database/migrations
        - Modules/*/database/migrations
